module Arfi
  module Commands
    class Functions < Thor
      ADAPTERS: ::Array[:postgresql | :mysql | :trilogy]

      ROOT_DIR: "db/functions"

      DEFAULT_SCHEMA: "public"

      IDENT: ::Regexp

      # steep:ignore:end
      def create: (untyped function_ref) -> untyped

      # steep:ignore:end
      def destroy: (untyped function_ref) -> (nil | untyped)

      # steep:ignore:end
      def list: () -> untyped

      private

      def validate_schema_format!: () -> untyped

      def validate_adapter_option!: () -> (nil | untyped)

      # Accept:
      # - "my_fn"
      # - "public.my_fn"
      # - "audit.my_fn"
      # and/or --schema=audit + "my_fn"
      def parse_function_ref: (untyped ref) -> ::Array[untyped]

      def schema_opt: () -> untyped

      def validate_identifiers!: (untyped schema, untyped fn) -> (nil | untyped)

      def ensure_dirs!: (adapter: untyped, schema: untyped) -> (nil | untyped)

      def build_sql_function: (untyped schema, untyped fn, original_ref: untyped) -> (untyped | ::String)

      # Template vars:
      # - function_name / index_name: function name only
      # - schema_name: postgres schema (defaults to public), else nil
      # - qualified_name: "schema.fn" for postgres, else fn
      def build_from_file: (untyped schema, untyped fn, original_ref: untyped) -> untyped

      def write_file: (untyped schema, untyped fn, untyped content) -> (nil | untyped)

      def canonical_path: (untyped schema, untyped fn) -> untyped

      # For destroy/migration support: include legacy aliases too
      def function_paths: (untyped schema, untyped fn) -> untyped

      def adapter_opt: () -> untyped

      def infer_adapter_from_config: () -> untyped

      # Priority (higher wins), same spirit as the loader I suggested earlier:
      #  10: adapter explicit schema dir (postgresql/<schema>/fn.sql)
      #   9: adapter explicit public dir (postgresql/public/fn.sql, mysql/public/fn.sql)
      #   8: adapter legacy public       (postgresql/fn.sql, mysql/fn.sql)
      #   2: generic explicit public     (public/fn.sql)
      #   1: generic legacy public       (fn.sql)
      def resolve_functions_for: (adapter: untyped) -> untyped

      def collect_candidates: (glob: untyped, schema: untyped, source: untyped, origin: untyped, priority: untyped) -> untyped

      def print_table: (untyped rows) -> untyped

      def rel: (untyped path) -> untyped
    end
  end
end
